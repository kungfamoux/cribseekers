# Beta Environment Configuration
# Copy this file to .env.beta and update values

# API Configuration
NEXT_PUBLIC_API_URL=https://staging.cribseekers.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://staging.cribseekers.com

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_beta_google_maps_key_here

# Environment
NODE_ENV=production
NEXT_PUBLIC_BETA_MODE=true

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Sentry(Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx@o12345.ingest.sentry.io/123456
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_ENABLED=true
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Debug Mode
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_DEBUG_LOGGING=true

# Maintenance Mode
NEXT_PUBLIC_MAINTENANCE_MODE=false
